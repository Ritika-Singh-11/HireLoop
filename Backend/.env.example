# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/recruitloop

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# OAuth Credentials (Optional for Google / GitHub Login)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Gemini AI (Optional for AI Resume ATS & Mock Interviews)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway (Test keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_5173HireLoop
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Admin Access Whitelist (Comma separated emails)
ADMIN_EMAIL_WHITELIST=tpo@university.edu,admin@hireloop.io
